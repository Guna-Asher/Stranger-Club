# Local Docker Compose overrides — copy to `.env` if you want to change any
# of these; `docker compose up --build` works with none of this present at
# all (every value below has a built-in local-development-only default in
# docker-compose.yml). This file is committed; `.env` itself must never be
# (see .gitignore) since a real `.env` is where you'd put anything you
# didn't want checked in — for this Compose stack that's never actually
# required, since nothing here is a real credential.
#
# These variables affect ONLY `docker compose up` (docker-compose.yml).
# They have no effect on a production deployment (Render or otherwise) —
# see docs/deployment.md for the separate, real production configuration.

# --- PostgreSQL (local container only) ---
POSTGRES_USER=stranger_club
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=stranger_club

# --- MinIO (local S3-compatible storage container only) ---
MINIO_ROOT_USER=local_storage_admin
MINIO_ROOT_PASSWORD=local_storage_admin_password
SC_STORAGE_BUCKET=stranger-club-local

# --- Application ---
SC_ADMIN_USERNAME=organizer
SC_ADMIN_PASSWORD=local-development-only

# --- Host port mappings (change if 8000/5432/9000/9001 are already taken
# on your machine — this changes only which host port reaches the
# container; the app always talks to postgres:5432 / minio:9000
# internally, regardless of these) ---
APP_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
